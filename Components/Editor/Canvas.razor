    private void OnItemContextMenu(ReportItem it, MouseEventArgs e)
    {
        if (!State.IsSelected(it)) State.Select(it);
        _ctxMenu = new CtxMenu(e.ClientX, e.ClientY);
    }

    private async Task CtxAction(string action)
    {
        _ctxMenu = null;
        switch (action)
        {
            case "cut":       await Cut(); break;
            case "copy":      Copy(); break;
            case "paste":     await Paste(); break;
            case "duplicate": Duplicate(); break;
            case "delete":    DeleteSelected(); break;
            case "front":     LayerSelected(+1000); break;
            case "back":      LayerSelected(-1000); break;
        }
    }

    private async Task CommitInlineEdit(Textbox tb)
    {
        try
        {
            var text = await JS.InvokeAsync<string>("ReportEditor.getElementTextById", InlineEditId);
            State.Mutate(() => tb.PrimaryText = text ?? "");
        }
        catch { }
        _editingId = null;
        StateHasChanged();
    }

    private async Task OnCanvasClick(MouseEventArgs e)
    {
        _ctxMenu = null;
        // If we just finished a rubber-band drag, the synthetic click that
        // follows must not clear the selection we built.
        if ((DateTime.UtcNow - _lastRubberBand).TotalMilliseconds < 300) return;
        if (State.PlacingKind is { } kind && State.Report != null && State.CurrentContainer != null)
        {
            var px = e.OffsetX / _zoom;
            var py = e.OffsetY / _zoom;
            var left = SsrsUnit.FromMm(px / 96.0 * 25.4);
            var top  = SsrsUnit.FromMm(py / 96.0 * 25.4);

            var name = State.UniqueName(kind);
            System.Xml.Linq.XElement xml = kind switch
            {
                "Textbox"   => ItemFactory.Textbox(name, left, top, text: "Text"),
                "Image"     => ItemFactory.Image(name, left, top),
                "Rectangle" => ItemFactory.Rectangle(name, left, top),
                "Line"      => ItemFactory.Line(name, left, top),
                "Tablix"    => ItemFactory.Tablix(name, left, top),
                "Subreport" => ItemFactory.Subreport(name, left, top),
                _ => ItemFactory.Textbox(name, left, top)
            };
            ReportItem? created = null;
            State.Mutate(() => created = State.Report!.AddItemTo(State.CurrentContainer, xml));
            if (created != null) State.Select(created);
            State.CancelPlacing();
            return;
        }
        State.Select(null);
        await Task.CompletedTask;
    }

    // ---------- cut/copy/paste/duplicate/delete ----------

    private async Task Cut()
    {
        if (State.SelectedItems.Count == 0) return;
        Copy();
        DeleteSelected();
    }

    private void Copy()
    {
        if (State.SelectedItems.Count == 0) return;
        State.Clipboard.Clear();
        foreach (var it in State.SelectedItems)
            State.Clipboard.Add(new System.Xml.Linq.XElement(it.Xml));
        // Best-effort system clipboard mirror — won't survive Blazor circuit boundary
        // but lets you paste between browser tabs of the same editor.
        try
        {
            var xml = string.Join("\n", State.SelectedItems.Select(i => i.Xml.ToString()));
            _ = JS.InvokeVoidAsync("navigator.clipboard.writeText",
                $"<RdlItems>\n{xml}\n</RdlItems>");
        }
        catch { }
    }

    private async Task Paste()
    {
        if (State.Report == null || State.CurrentContainer == null) return;
        // Prefer in-memory clipboard. Otherwise try system clipboard.
        var sources = State.Clipboard.Count > 0
            ? State.Clipboard.Select(x => new System.Xml.Linq.XElement(x)).ToList()
            : await ReadClipboardItems();
        if (sources.Count == 0) return;

        var created = new List<ReportItem>();
        State.Mutate(() =>
        {
            foreach (var src in sources)
            {
                var kind = src.Name.LocalName;
                var name = State.UniqueName(kind);
                var clone = ItemFactory.Duplicate(src, name,
                    SsrsUnit.FromMm(5), SsrsUnit.FromMm(5));
                created.Add(State.Report.AddItemTo(State.CurrentContainer, clone));
            }
        });
        State.SelectMany(created);
    }

    private async Task<List<System.Xml.Linq.XElement>> ReadClipboardItems()
    {
        try
        {
            var text = await JS.InvokeAsync<string>("navigator.clipboard.readText");
            if (string.IsNullOrWhiteSpace(text) || !text.TrimStart().StartsWith("<")) return new();
            // Parse and find children of <RdlItems>.
            var doc = System.Xml.Linq.XElement.Parse(text);
            // Re-namespace bare elements to the RDL namespace if needed.
            var items = doc.Elements().Select(e =>
                e.Name.Namespace == System.Xml.Linq.XNamespace.None
                    ? new System.Xml.Linq.XElement(Ns.R + e.Name.LocalName, e.Attributes(), e.Nodes())
                    : new System.Xml.Linq.XElement(e)).ToList();
            return items;
        }
        catch { return new(); }
    }

    private void Duplicate()
    {
        if (State.Report == null || State.CurrentContainer == null || State.SelectedItems.Count == 0) return;
        var items = State.SelectedItems.ToList();
        var created = new List<ReportItem>();
        State.Mutate(() =>
        {
            foreach (var it in items)
            {
                var name = State.UniqueName(it.Kind);
                var clone = ItemFactory.Duplicate(it.Xml, name,
                    SsrsUnit.FromMm(5), SsrsUnit.FromMm(5));
                created.Add(State.Report.AddItemTo(State.CurrentContainer, clone));
            }
        });
        State.SelectMany(created);
    }

    private void DeleteSelected()
    {
        if (State.SelectedItems.Count == 0) return;
        var items = State.SelectedItems.ToList();
        State.Mutate(() => { foreach (var it in items) it.Xml.Remove(); });
        State.Select(null);
    }

    private void LayerSelected(int delta)
    {
        if (State.SelectedItems.Count == 0) return;
        var items = State.SelectedItems.ToList();
        State.Mutate(() => { foreach (var i in items) i.ZIndex += delta; });
    }

    // ---------- JS module installation ----------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.Report == null) return;
        if (!_modulesInstalled)
        {
            _self ??= DotNetObjectReference.Create(this);
            _dragModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/drag.js");
            await _dragModule.InvokeVoidAsync("installRubberBand", _canvasEl, _self);
            await _dragModule.InvokeVoidAsync("installTablixResize", _canvasEl, _self);
            _modulesInstalled = true;
        }
        // (Re-)bind tablix handles after each render since the gridline DOM changes.
        if (_dragModule != null)
            await _dragModule.InvokeVoidAsync("rebindTablixHandles", _canvasEl);
    }

    [JSInvokable]
    public void SelectInRect(double xPx, double yPx, double wPx, double hPx)
    {
        if (State.Report == null) return;
        _lastRubberBand = DateTime.UtcNow;
        var x1 = xPx / _zoom;
        var y1 = yPx / _zoom;
        var x2 = x1 + wPx / _zoom;
        var y2 = y1 + hPx / _zoom;
        var picked = new List<ReportItem>();
        foreach (var it in State.CurrentItems)
        {
            var il = it.Left.Px;
            var itp = it.Top.Px;
            var ir = il + it.Width.Px;
            var ib = itp + it.Height.Px;
            if (ir >= x1 && il <= x2 && ib >= y1 && itp <= y2) picked.Add(it);
        }
        if (picked.Count > 0) State.SelectMany(picked);
        else State.Select(null);
    }

    private TablixItem? FindEnclosingTablix(ReportItem? it)
    {
        if (it == null || State.Report == null) return null;
        if (it is TablixItem tx) return tx;
        // Walk up the XElement chain to find a <Tablix> ancestor.
        var p = it.Xml.Parent;
        while (p != null)
        {
            if (p.Name.LocalName == "Tablix")
            {
                // Find the wrapper in the current scope.
                foreach (var ci in State.CurrentItems)
                    if (ci is TablixItem ct && ReferenceEquals(ct.Xml, p))
                        return ct;
                return new TablixItem(p);
            }
            p = p.Parent;
        }
        return null;
    }

    [JSInvokable]
    public void CommitTablixResize(string tablixName, string axis, int index, double deltaPx)
    {
        if (State.Report == null) return;
        var tx = State.CurrentItems.OfType<TablixItem>().FirstOrDefault(x => x.Name == tablixName);
        if (tx == null) return;
        var deltaMm = deltaPx / 96.0 * 25.4;
        State.Mutate(() =>
        {
            if (axis == "col")
            {
                var cols = tx.Columns;
                if (index < 0 || index >= cols.Count) return;
                var c = cols[index];
                var newMm = Math.Max(2, c.Width.Mm + deltaMm);
                c.Width = c.Width.WithMm(newMm);
                tx.Width = tx.Width.WithMm(tx.TotalColMm);
            }
            else
            {
                var rows = tx.Rows;
                if (index < 0 || index >= rows.Count) return;
                var r = rows[index];
                var newMm = Math.Max(2, r.Height.Mm + deltaMm);
                r.Height = r.Height.WithMm(newMm);
                tx.Height = tx.Height.WithMm(tx.TotalRowMm);
            }
        });
    }

