    private string RtToolbarStyle(Textbox tb)
        => $"left:{tb.Left.Px:0.##}px;top:{Math.Max(0, tb.Top.Px - 36):0.##}px;";

    private void Rt(char which)
    {
        if (State.Selected is not Textbox tb) return;
        State.Mutate(() =>
        {
            // Toggle on the first run of the first paragraph (simple model — full
            // selection-aware rich-text is a different beast).
            var run = tb.Paragraphs.FirstOrDefault()?.Runs.FirstOrDefault();
            if (run == null) return;
            switch (which)
            {
                case 'b':
                    run.Style.FontWeight = run.Style.FontWeight == "Bold" ? null : "Bold";
                    break;
                case 'i':
                    run.Style.FontStyle = run.Style.FontStyle == "Italic" ? null : "Italic";
                    break;
                case 'u':
                    run.Style.TextDecoration = run.Style.TextDecoration == "Underline" ? null : "Underline";
                    break;
            }
        });
    }

    private void RtColor(string? color)
    {
        if (State.Selected is not Textbox tb || string.IsNullOrEmpty(color)) return;
        State.Mutate(() =>
        {
            var run = tb.Paragraphs.FirstOrDefault()?.Runs.FirstOrDefault();
            if (run != null) run.Style.Color = color;
        });
    }

    private void RtAlign(string align)
    {
        if (State.Selected is not Textbox tb) return;
        State.Mutate(() =>
        {
            var para = tb.Paragraphs.FirstOrDefault();
            if (para != null) para.Style.TextAlign = align;
        });
    }

    private List<double> ComputePageBreaks(Report r)
    {
        var list = new List<double>();
        if (State.Scope != EditorState.EditScope.Body) return list;
        // Page-content height in mm = PageHeight - top - bottom - header - footer.
        var pageMm = r.PageHeight.Mm - r.MarginTop.Mm - r.MarginBottom.Mm
                     - (r.PageHeader?.Element(Ns.R + "Height")?.Value is { } hh ? SsrsUnit.Parse(hh).Mm : 0)
                     - (r.PageFooter?.Element(Ns.R + "Height")?.Value is { } ff ? SsrsUnit.Parse(ff).Mm : 0);
        if (pageMm < 10) return list;
        var bodyMm = r.BodyHeight.Mm;
        var y = pageMm;
        while (y < bodyMm)
        {
            list.Add(SsrsUnit.FromMm(y).Px);
            y += pageMm;
        }
        return list;
    }

    // ---------- finder ----------
    private bool _finderVisible;
    private string _finderText = "";
    private ElementReference _finderRef;

    public async Task ShowFinder()
    {
        _finderVisible = true;
        _finderText = "";
        await InvokeAsync(StateHasChanged);
        try { await JS.InvokeVoidAsync("ReportEditor.focusElement", _finderRef); } catch { }
    }

    public void HideFinder() { _finderVisible = false; _finderText = ""; StateHasChanged(); }

    private void OnFinderInput(ChangeEventArgs e) => _finderText = e.Value?.ToString() ?? "";

    private void OnFinderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") HideFinder();
        else if (e.Key == "Enter")
        {
            var first = FinderMatches().FirstOrDefault();
            if (first != null) JumpTo(first);
        }
    }

    private IEnumerable<ReportItem> FinderMatches()
    {
        if (State.Report == null || string.IsNullOrWhiteSpace(_finderText))
            return Array.Empty<ReportItem>();
        var t = _finderText.Trim();
        return AllItems().Where(i =>
            (i.Name?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private IEnumerable<ReportItem> AllItems()
    {
        if (State.Report == null) yield break;
        IEnumerable<ReportItem> Walk(IEnumerable<ReportItem> xs)
        {
            foreach (var x in xs)
            {
                yield return x;
                if (x is RectangleItem rc)
                    foreach (var c in Walk(rc.Children)) yield return c;
            }
        }
        if (State.Report.Body != null)
            foreach (var x in Walk(State.Report.ItemsIn(State.Report.Body))) yield return x;
        if (State.Report.PageHeader != null)
            foreach (var x in Walk(State.Report.ItemsIn(State.Report.PageHeader))) yield return x;
        if (State.Report.PageFooter != null)
            foreach (var x in Walk(State.Report.ItemsIn(State.Report.PageFooter))) yield return x;
    }

    private void JumpTo(ReportItem it)
    {
        State.Select(it);
        HideFinder();
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_dragModule != null) await _dragModule.DisposeAsync(); } catch { }
        _self?.Dispose();
    }
}
